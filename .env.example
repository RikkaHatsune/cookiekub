# Скопируйте в backend/.env или задайте переменные в Render.
# Для локального запуска без .env работают значения по умолчанию.

DATABASE_URL=postgresql://postgres@127.0.0.1:5433/cookiekub
SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=development
SUPPORT_EMAIL=support@cookiekub.ru
ORDER_COMPLETE_DELAY_SECONDS=60
SESSION_TTL_DAYS=7
MAINTENANCE_TOKEN=change-me-maintenance-token
RATE_LIMIT_ENABLED=true

# Через запятую. Для GitHub Pages укажите https://<username>.github.io
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:8000,http://localhost:8000
